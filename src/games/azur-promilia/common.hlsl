#ifndef SRC_GAMES_AZUR_PROMILIA_COMMON_HLSL_
#define SRC_GAMES_AZUR_PROMILIA_COMMON_HLSL_

#include "./shared.h"

// UberPost (uberpost/*.hlsl, generated by tmp/tasks/azur-promilia/scripts/gen_uberpost.py) keeps the
// game's SDR tail: luminance/per-channel ACES blend -> saturate -> LDR 2D LUT -> in-game BCS.
// That result is the graded SDR reference for the untonemapped exposed scene color.
//
// Frame chain after UberPost (R11G11B10): Blit lin->sRGB (RGBA16F, UI drawn in gamma) ->
// Blit sRGB->lin (RGBA8 sRGB view, upgraded) -> core blit 0x20133A8B to the swap chain, so the
// swap chain receives linear values and the intermediate encoding defaults to None.
float3 UpgradeUberPost(float3 untonemapped, float3 graded_sdr) {
  float3 output_color = graded_sdr;
  if (RENODX_TONE_MAP_TYPE != 0.f) {
    output_color = renodx::draw::ToneMapPass(untonemapped, graded_sdr);
  }
  return renodx::draw::RenderIntermediatePass(output_color);
}

#endif  // SRC_GAMES_AZUR_PROMILIA_COMMON_HLSL_
