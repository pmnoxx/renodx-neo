// Original: shader.dat/filtershadercameravelocity.pso - camera-motion velocity buffer for motion blur.
// Readable reconstruction; compiles to the game bytecode (verify_rewrite.py). The mod replaces
// this shader with zero velocity when "Disable camera motion blur" is enabled.
cbuffer SceneBuffer : register(b0) {
  float4 scene_buffer[15];  // [4].x, [5].y: projection scale; [12..14]: view-to-world rows
}
cbuffer CameraParams : register(b13) {
  float4 camera_params;  // depth = raw * y + x
}
cbuffer ParamBuffer : register(b1) {
  float4 blur_params;  // x: blur strength
  float4 old_view_projection[4];
}
SamplerState depth_sampler : register(s13);
Texture2D<float4> depth_texture : register(t13);

float4 main(float4 position : SV_POSITION, float2 uv : TEXCOORD0) : SV_Target0 {
  float2 inverse_projection = 1.0 / float2(scene_buffer[4].x, scene_buffer[5].y);
  float depth = depth_texture.Sample(depth_sampler, uv).r * camera_params.y + camera_params.x;
  float2 current_ndc = uv * float2(2.0, -2.0) + float2(-1.0, 1.0);

  // Reconstruct the world position, then project it with last frame's camera.
  float4 view_position = float4(inverse_projection * (depth * current_ndc), -depth, 1.0);
  float4 world_position = float4(
      dot(view_position, scene_buffer[12]),
      dot(view_position, scene_buffer[13]),
      dot(view_position, scene_buffer[14]),
      1.0);
  float2 previous_clip = float2(
      dot(world_position, old_view_projection[0]),
      dot(world_position, old_view_projection[1]));
  float previous_clip_w = dot(world_position, old_view_projection[3]);
  float2 velocity = (current_ndc - previous_clip / previous_clip_w) * 2.0;

  // Fade the effect in over the first 100 depth units.
  float depth_weight = saturate(depth * 0.01);
  depth_weight *= depth_weight;
  return float4(velocity * depth_weight * blur_params.x + 0.5, 0.0, 0.0);
}
