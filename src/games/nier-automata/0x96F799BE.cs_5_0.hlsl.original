// Original: shader2.dat/casshaderupsampleandsharpen.cso - AMD FidelityFX CAS, upscale + sharpen.
// Readable rewrite following AMD's public ffx_cas.h CasFilter scaling path (green-channel
// amplitude, fast approximations); compiles to the game bytecode (verify_rewrite.py).
cbuffer cb : register(b0) { uint4 const0 : packoffset(c0); uint4 const1 : packoffset(c1); }
Texture2D<float4> InputTexture : register(t0);
RWTexture2D<float4> OutputTexture : register(u0);

// ffx_a.h approximations on float bit patterns. Do not replace with rcp/sqrt.
float APrxLoRcp(float x) { return asfloat(0x7ef07ebbu - asuint(x)); }
float APrxLoSqrt(float x) { return asfloat((asuint(x) >> 1) + 0x1fbc4639u); }
float APrxMedRcp(float x) { float r = asfloat(0x7ef19fffu - asuint(x)); return r * mad(-r, x, 2.0); }
float AMin3(float x, float y, float z) { return min(x, min(y, z)); }
float AMax3(float x, float y, float z) { return max(x, max(y, z)); }

float3 CasLoad(int2 p) { return InputTexture.Load(int3(p, 0)).rgb; }

// Sharpening lobe weight from the soft min/max of a cross.
float CasWeight(float mn, float mx) {
  return APrxLoSqrt(saturate(min(mn, 1.0 - mx) * APrxLoRcp(mx))) * asfloat(const1.x);
}

// Adaptively interpolate the four nearest non-scaled CAS results f, g, j, k:
//  a b c d
//  e f g h
//  i j k l
//  m n o p
float3 CasUpscale(uint2 ip) {
  float2 pp = float2(ip) * asfloat(const0.xy) + asfloat(const0.zw);
  float2 fp = floor(pp);
  pp -= fp;
  int2 sp = int2(fp);
  float3 b = CasLoad(sp + int2(0, -1));
  float3 e = CasLoad(sp + int2(-1, 0));
  float3 f = CasLoad(sp);
  float3 c = CasLoad(sp + int2(1, -1));
  float3 g = CasLoad(sp + int2(1, 0));
  float3 h = CasLoad(sp + int2(2, 0));
  float3 i = CasLoad(sp + int2(-1, 1));
  float3 j = CasLoad(sp + int2(0, 1));
  float3 n = CasLoad(sp + int2(0, 2));
  float3 k = CasLoad(sp + int2(1, 1));
  float3 l = CasLoad(sp + int2(2, 1));
  float3 o = CasLoad(sp + int2(1, 2));

  // Soft min/max of green over each result's cross.
  float mnf = AMin3(AMin3(b.g, e.g, f.g), g.g, j.g);
  float mxf = AMax3(AMax3(b.g, e.g, f.g), g.g, j.g);
  float mng = AMin3(AMin3(c.g, f.g, g.g), h.g, k.g);
  float mxg = AMax3(AMax3(c.g, f.g, g.g), h.g, k.g);
  float mnj = AMin3(AMin3(f.g, i.g, j.g), k.g, n.g);
  float mxj = AMax3(AMax3(f.g, i.g, j.g), k.g, n.g);
  float mnk = AMin3(AMin3(g.g, j.g, k.g), l.g, o.g);
  float mxk = AMax3(AMax3(g.g, j.g, k.g), l.g, o.g);
  float wf = CasWeight(mnf, mxf);
  float wg = CasWeight(mng, mxg);
  float wj = CasWeight(mnj, mxj);
  float wk = CasWeight(mnk, mxk);

  // Bilinear weights  s t / u v, thinned by local contrast to hide interpolation.
  float s = (1.0 - pp.x) * (1.0 - pp.y);
  float t = pp.x * (1.0 - pp.y);
  float u = (1.0 - pp.x) * pp.y;
  float v = pp.x * pp.y;
  const float thin = 1.0 / 32.0;
  s *= APrxLoRcp(thin + (mxf - mnf));
  t *= APrxLoRcp(thin + (mxg - mng));
  u *= APrxLoRcp(thin + (mxj - mnj));
  v *= APrxLoRcp(thin + (mxk - mnk));

  // Final weights per texel (outer pairs share one weight each).
  float qbe = wf * s;
  float qch = wg * t;
  float qf = wg * t + wj * u + s;
  float qg = wf * s + wk * v + t;
  float qj = wf * s + wk * v + u;
  float qk = wg * t + wj * u + v;
  float qin = wj * u;
  float qlo = wk * v;
  float rcp_weight = APrxMedRcp(2.0 * qbe + 2.0 * qch + 2.0 * qin + 2.0 * qlo + qf + qg + qj + qk);
  return saturate((b * qbe + e * qbe + c * qch + h * qch + i * qin + n * qin + l * qlo + o * qlo
                   + f * qf + g * qg + j * qj + k * qk) * rcp_weight);
}

void Filter(uint2 pos) {
  OutputTexture[pos] = float4(CasUpscale(pos), 1);
}

// ffx_a.h ARmp8x8: 64 lanes -> 8x8 tile in a swizzled order.
uint2 ARmp8x8(uint a) { return uint2((a >> 1) & 7u, ((a >> 3) & ~1u) | (a & 1u)); }

// Each 64-thread group covers a 16x16 tile as four 8x8 quadrants.
[numthreads(64, 1, 1)]
void main(uint3 groupID : SV_GroupID, uint3 localID : SV_GroupThreadID) {
  uint2 gxy = ARmp8x8(localID.x) + uint2(groupID.x << 4u, groupID.y << 4u);
  Filter(gxy);
  gxy.x += 8u;
  Filter(gxy);
  gxy.y += 8u;
  Filter(gxy);
  gxy.x -= 8u;
  Filter(gxy);
}
